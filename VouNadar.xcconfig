// Configuração de build do Vou Nadar.
//
// Nenhum destes valores é segredo: o app não tem chave de API, endpoint nem
// variável de ambiente (spec 18 e 20). Se um segredo aparecer aqui um dia, é
// sinal de que o princípio 0.4 foi quebrado e alguém está introduzindo backend.

// Assunção 24.1, confirmada pelo Alexandre: bundle registrado no App Store
// Connect. O watchOS e a complication derivam deste prefixo.
BUNDLE_ID = com.dablab.vounadar

MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 2

// Conta Apple Developer da Dab Lab. Necessária para instalar em aparelho real,
// que é onde o teste de piscina da seção 22 acontece.
DEVELOPMENT_TEAM = XGZW6Y6K25
